# Copy to .env for local web builds. Edge secrets are set with the Supabase CLI, not this file.
# Leave a value empty to keep that feature off.

# Website kill switch. The database global flag must also be true.
VITE_SAFEGUARDING_ENABLED=false

# Website Sentry. Off when unset. Session replay is disabled in code.
VITE_SENTRY_DSN=

# Edge function Sentry. Off when unset. Same scrubber as the website.
SENTRY_DSN=

# Real safety flags and out-of-hours monitoring alerts.
DSL_ALERT_EMAIL=rafa@collaborate8.com,jade@collaborate8.com

# Test-account families only. If unset, those emails are dropped.
QA_ALERT_EMAIL=collaborate8-qa@agentmail.to

# SMS channel. Provider is not chosen yet. All four must be set or SMS is skipped.
# DSL_SMS_NUMBERS is a comma-separated E.164 list. Do not commit real numbers.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
DSL_SMS_NUMBERS=
